# Copy to .env before running `docker compose up --build`.
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"

POSTGRES_USER=siem
POSTGRES_PASSWORD=change-this-database-password
POSTGRES_DB=siem

# development keeps the bootstrap admin usable without extra setup.
# In production, use secrets with at least 32 characters and an admin password
# with at least 12 non-default characters.
SIEM_ENV=development
SIEM_JWT_SECRET=replace-with-a-long-random-string
SIEM_JWT_MINUTES=480
SIEM_ADMIN_USER=admin
SIEM_ADMIN_PASSWORD=admin

# ARGUS (attack surface) — separate database and secrets.
ARGUS_DB_USER=argus
ARGUS_DB_PASSWORD=change-this-database-password
ARGUS_DB_NAME=argus
ARGUS_ENV=development
ARGUS_JWT_SECRET=replace-with-another-long-random-string
ARGUS_JWT_MINUTES=480
ARGUS_ADMIN_USER=admin
ARGUS_ADMIN_PASSWORD=admin
